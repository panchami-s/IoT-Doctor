# ── Groq API ──────────────────────────────────────────────────────────────────
# Get your free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Free open-source model choices (pick one):
#   llama3-8b-8192        ← recommended (fast, accurate)
#   llama3-70b-8192       ← more powerful, slower
#   mixtral-8x7b-32768    ← large context window
GROQ_MODEL=llama3-8b-8192

# ── Flask ─────────────────────────────────────────────────────────────────────
# Change this to any random string in production
FLASK_SECRET_KEY=my-iot-doctor-secret-2026
